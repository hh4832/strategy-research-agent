{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/hh4832/strategy-research-agent/STRATEGY_SPEC_SCHEMA.json",
  "title": "Strategy Specification v1.0",
  "description": "Machine-readable, reproducible strategy definition for the Phase-3 Strategy Research Agent. Structural rules live here; cross-field semantic rules (look-ahead, warm-up, parameter constraints, snapshot pinning) are enforced by strategy_agent.spec.validate and documented in STRATEGY_AGENT_ARCHITECTURE.md §4.",
  "type": "object",
  "additionalProperties": false,
  "required": ["spec_version", "strategy_id", "version", "status", "hypothesis", "universe", "data_requirements",
               "parameters", "signal", "position_sizing", "risk_exits", "execution", "costs",
               "risk_constraints", "experiment", "provenance"],
  "properties": {
    "spec_version": {"const": "1.0.0"},
    "strategy_id": {"type": "string", "pattern": "^[a-z][a-z0-9_]{2,63}$"},
    "name": {"type": "string", "maxLength": 120},
    "version": {"type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$"},
    "status": {"enum": ["DRAFT", "REGISTERED", "FROZEN", "RETIRED"],
               "description": "DRAFT may contain unresolved snapshot refs. REGISTERED/FROZEN must be fully pinned; FROZEN specs are immutable and are the only ones allowed to touch the final holdout."},

    "hypothesis": {
      "type": "object", "additionalProperties": false,
      "required": ["statement", "mechanism", "falsifiable_prediction", "null_hypothesis", "rationale_category"],
      "properties": {
        "statement": {"type": "string", "minLength": 20},
        "mechanism": {"type": "string", "minLength": 20, "description": "Why the effect should exist (who is on the other side, which friction or behaviour)."},
        "falsifiable_prediction": {"type": "string", "minLength": 10},
        "null_hypothesis": {"type": "string", "minLength": 10},
        "rationale_category": {"enum": ["TREND_FOLLOWING", "MEAN_REVERSION", "VOLATILITY_BREAKOUT", "SESSION_EFFECT",
                                         "LEAD_LAG", "LIQUIDITY_PROVISION", "EVENT_DRIFT", "OTHER"]},
        "expected_holding_period": {"type": "string"},
        "known_failure_modes": {"type": "array", "items": {"type": "string"}},
        "references": {"type": "array", "items": {"type": "string"}}
      }
    },

    "universe": {
      "type": "object", "additionalProperties": false,
      "required": ["market", "symbols", "timeframe", "timezone", "contract_policy", "sessions"],
      "properties": {
        "market": {"enum": ["IBKR", "TXF", "TW"]},
        "symbols": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "timeframe": {"enum": ["1m", "5m", "15m", "30m", "60m", "1d"]},
        "source_timeframe": {"enum": ["1m", "5m"], "description": "Native snapshot timeframe if bars are aggregated."},
        "aggregation": {
          "type": "object", "additionalProperties": false,
          "required": ["label", "closed", "require_complete"],
          "properties": {
            "label": {"const": "start"},
            "closed": {"const": "left"},
            "require_complete": {"type": "boolean", "description": "true: an aggregated bar is formed only if every constituent source bar exists and is eligible."},
            "session_anchored": {"type": "boolean", "default": true}
          }
        },
        "timezone": {"enum": ["UTC", "Asia/Taipei", "America/New_York"]},
        "contract_policy": {
          "type": "object", "additionalProperties": false,
          "required": ["type", "continuous_inferred"],
          "properties": {
            "type": {"enum": ["NOT_APPLICABLE", "EXPLICIT_CONTRACTS", "SCHEDULED_ROLL", "PRODUCER_CONTINUOUS_WITH_ACTUAL_MONTH"]},
            "contracts": {"type": "array", "items": {"type": "string"}},
            "roll_schedule": {"type": "array", "items": {
              "type": "object", "additionalProperties": false, "required": ["at", "from_contract", "to_contract"],
              "properties": {"at": {"type": "string", "format": "date-time"}, "from_contract": {"type": "string"}, "to_contract": {"type": "string"}}}},
            "continuous_inferred": {"const": false, "description": "Roll-rule inference and engine-built continuous series are forbidden (Phase-1/2 contract)."},
            "no_position_across_contract_change": {"type": "boolean"},
            "indicator_series": {"enum": ["PER_CONTRACT", "NOT_APPLICABLE"]}
          }
        },
        "sessions": {
          "type": "object", "additionalProperties": false,
          "required": ["allowed", "calendar_ref"],
          "properties": {
            "allowed": {"type": "array", "minItems": 1, "items": {"enum": ["REGULAR", "AFTERHOURS", "RTH", "ETH"]}},
            "calendar_ref": {"type": "string"},
            "exclude_closing_auction": {"type": "boolean", "default": true},
            "no_overnight": {"type": "boolean"}
          }
        }
      }
    },

    "data_requirements": {
      "type": "object", "additionalProperties": false,
      "required": ["datasets", "warmup_bars"],
      "properties": {
        "datasets": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/dataset_ref"}},
        "warmup_bars": {"type": "integer", "minimum": 0, "description": "Must be >= the largest indicator lookback at the MAXIMUM of each parameter range (checked by validator)."},
        "fields": {"type": "array", "items": {"type": "string"}},
        "pit_fields": {"type": "array", "items": {
          "type": "object", "additionalProperties": false, "required": ["field", "available_at_rule"],
          "properties": {
            "field": {"type": "string"},
            "available_at_rule": {"type": "string", "minLength": 5, "description": "e.g. 'publication timestamp from source', 'as_of + 1 trading day 08:30 Asia/Taipei'. Joining on as_of date is forbidden."}
          }}},
        "min_history": {"type": "string"}
      }
    },

    "parameters": {
      "type": "object",
      "additionalProperties": false,
      "required": ["values", "constraints", "search"],
      "properties": {
        "values": {"type": "object", "minProperties": 0, "additionalProperties": {"$ref": "#/$defs/parameter"}},
        "constraints": {"type": "array", "items": {
          "type": "object", "additionalProperties": false, "required": ["left", "op", "right"],
          "properties": {"left": {"type": "string"}, "op": {"enum": ["<", "<=", ">", ">=", "!="]}, "right": {"type": ["string", "number"]}}}},
        "search": {
          "type": "object", "additionalProperties": false, "required": ["mode"],
          "properties": {
            "mode": {"enum": ["FIXED", "PREREGISTERED_GRID"], "description": "Phase-3 preparation: FIXED only for registration. PREREGISTERED_GRID must be run under QUANT_EVALUATION_PROTOCOL walk-forward and counts every point as a trial."},
            "max_trials": {"type": "integer", "minimum": 1}
          }
        }
      }
    },

    "signal": {
      "type": "object", "additionalProperties": false,
      "required": ["evaluation_time", "indicators", "entry_rules", "exit_rules"],
      "properties": {
        "evaluation_time": {"const": "BAR_CLOSE", "description": "Decisions are made only at bar available_at (bar end). Intrabar decisions are out of scope for v1."},
        "indicators": {"type": "array", "items": {"$ref": "#/$defs/indicator"}},
        "entry_rules": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/rule"}},
        "exit_rules": {"type": "array", "items": {"$ref": "#/$defs/rule"}},
        "max_entries_per_session": {"type": "integer", "minimum": 1}
      }
    },

    "position_sizing": {
      "type": "object", "additionalProperties": false, "required": ["method"],
      "properties": {
        "method": {"enum": ["FIXED_UNITS", "FIXED_NOTIONAL", "VOLATILITY_TARGET"]},
        "units": {"type": "number", "exclusiveMinimum": 0},
        "notional": {"type": "number", "exclusiveMinimum": 0},
        "target_annual_vol": {"type": "number", "exclusiveMinimum": 0},
        "vol_lookback_bars": {"type": "integer", "minimum": 2},
        "lot_size": {"type": "number", "exclusiveMinimum": 0},
        "contract_multiplier": {"type": "number", "exclusiveMinimum": 0},
        "max_units": {"type": "number", "exclusiveMinimum": 0},
        "initial_capital": {"type": "number", "exclusiveMinimum": 0}
      }
    },

    "risk_exits": {
      "type": "object", "additionalProperties": false, "required": ["stop_loss", "take_profit", "time_exit"],
      "properties": {
        "stop_loss": {"$ref": "#/$defs/exit_level"},
        "take_profit": {"$ref": "#/$defs/exit_level"},
        "time_exit": {
          "type": "object", "additionalProperties": false,
          "properties": {
            "flatten_decision_time_local": {"type": "string", "pattern": "^\\d{2}:\\d{2}$"},
            "max_holding_bars": {"type": "integer", "minimum": 1},
            "flatten_before_session_end": {"type": "boolean"}
          }
        }
      }
    },

    "execution": {
      "type": "object", "additionalProperties": false,
      "required": ["signal_time", "order_time", "fill_rule", "order_type", "time_in_force", "partial_fills", "convention"],
      "properties": {
        "convention": {"const": "oracle-execution-convention-v1"},
        "signal_time": {"const": "BAR_AVAILABLE_AT"},
        "order_time": {"const": "SIGNAL_TIME"},
        "fill_rule": {"const": "NEXT_ELIGIBLE_BAR_OPEN", "description": "First bar with start >= order_time that exists, is in session, is not excluded, has volume > 0, and is not limit-locked against the order side."},
        "order_type": {"const": "MARKET"},
        "time_in_force": {"const": "UNTIL_END_OF_NEXT_SESSION_END", "description": "Live until the end of the first session whose end is after order_time."},
        "max_fill_delay_bars": {"type": "integer", "minimum": 1},
        "partial_fills": {"const": false},
        "same_bar_reentry": {"const": false}
      }
    },

    "costs": {
      "type": "object", "additionalProperties": false,
      "required": ["currency", "fee", "tax", "slippage", "sensitivity_multipliers"],
      "properties": {
        "currency": {"enum": ["TWD", "USD"]},
        "fee": {
          "type": "object", "additionalProperties": false, "required": ["per_unit_side", "rate_side"],
          "properties": {
            "per_unit_side": {"type": "number", "minimum": 0},
            "rate_side": {"type": "number", "minimum": 0, "maximum": 0.01},
            "min_per_order": {"type": "number", "minimum": 0},
            "rounding": {"enum": ["NONE", "FLOOR_INTEGER", "ROUND_HALF_UP_INTEGER"]}
          }
        },
        "tax": {
          "type": "object", "additionalProperties": false, "required": ["rate_side", "sell_rate"],
          "properties": {
            "rate_side": {"type": "number", "minimum": 0, "maximum": 0.01},
            "sell_rate": {"type": "number", "minimum": 0, "maximum": 0.01},
            "rounding": {"enum": ["NONE", "FLOOR_INTEGER", "ROUND_HALF_UP_INTEGER"]}
          }
        },
        "slippage": {
          "type": "object", "additionalProperties": false, "required": ["model", "value"],
          "properties": {
            "model": {"enum": ["TICKS", "BPS"]},
            "value": {"type": "number", "minimum": 0},
            "tick_size_ref": {"type": "string"}
          }
        },
        "sensitivity_multipliers": {"type": "array", "minItems": 3, "uniqueItems": true,
          "items": {"type": "number", "minimum": 0}, "description": "Cost multipliers re-run in evaluation; must include 0, 1 and at least one value >= 2."}
      }
    },

    "risk_constraints": {
      "type": "object", "additionalProperties": false, "required": ["allowed_directions", "max_position_units"],
      "properties": {
        "allowed_directions": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["LONG", "SHORT"]}},
        "max_position_units": {"type": "number", "exclusiveMinimum": 0},
        "max_gross_exposure": {"type": "number", "exclusiveMinimum": 0},
        "max_trades_per_session": {"type": "integer", "minimum": 1},
        "max_daily_loss": {"type": "number", "exclusiveMinimum": 0},
        "max_drawdown_halt": {"type": "number", "exclusiveMinimum": 0, "maximum": 1}
      }
    },

    "experiment": {
      "type": "object", "additionalProperties": false,
      "required": ["seed", "evaluation_protocol", "split_ref", "holdout_lock_id"],
      "properties": {
        "seed": {"type": "integer", "minimum": 0, "maximum": 4294967295},
        "evaluation_protocol": {"const": "QUANT_EVALUATION_PROTOCOL v1.0"},
        "split_ref": {"type": "string", "description": "ID of a pre-registered chronological split / walk-forward plan in the Experiment Registry."},
        "holdout_lock_id": {"type": "string", "description": "Lock record for the final holdout; the holdout may be evaluated once per FROZEN spec."},
        "trial_family_id": {"type": "string", "description": "Groups all variants that count toward the same multiple-testing family."},
        "compute_budget": {"type": "object", "additionalProperties": false,
          "properties": {"max_backtests": {"type": "integer", "minimum": 1}, "max_wall_minutes": {"type": "integer", "minimum": 1}}}
      }
    },

    "provenance": {
      "type": "object", "additionalProperties": false, "required": ["created_at", "created_by"],
      "properties": {
        "created_at": {"type": "string", "format": "date-time"},
        "created_by": {"type": "string"},
        "parent_spec_id": {"type": ["string", "null"]},
        "spec_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$", "description": "sha256 of canonical JSON with this field set to null."},
        "notes": {"type": "string"}
      }
    }
  },

  "$defs": {
    "dataset_ref": {
      "type": "object", "additionalProperties": false,
      "required": ["dataset_id", "snapshot_id", "producer_commit_sha", "verdict", "usage_scope"],
      "properties": {
        "dataset_id": {"type": "string"},
        "snapshot_id": {"type": "string", "minLength": 3},
        "producer_commit_sha": {"type": "string", "pattern": "^([0-9a-f]{7,40}|UNRESOLVED)$"},
        "manifest_sha256": {"type": "string", "pattern": "^([0-9a-f]{64}|UNRESOLVED)$"},
        "verdict": {"enum": ["GO", "SCOPED_GO", "PASS_WITH_CAVEATS"]},
        "usage_scope": {"enum": ["RESEARCH_ONLY", "BACKTEST", "ROBUSTNESS_ONLY"]},
        "mandatory_exclusions": {"type": "array", "items": {"type": "string"}},
        "access_contract": {"type": "string", "description": "Data Access Contract version the snapshot is read through."}
      }
    },
    "parameter": {
      "type": "object", "additionalProperties": false, "required": ["type", "default", "min", "max"],
      "properties": {
        "type": {"enum": ["integer", "number"]},
        "default": {"type": "number"},
        "min": {"type": "number"},
        "max": {"type": "number"},
        "step": {"type": "number", "exclusiveMinimum": 0},
        "description": {"type": "string"}
      }
    },
    "operand": {
      "oneOf": [
        {"type": "object", "additionalProperties": false, "required": ["ref"],
         "properties": {"ref": {"type": "string"}, "lag": {"type": "integer", "minimum": 0, "description": "Bars back. Negative lags (future bars) are structurally impossible."}}},
        {"type": "object", "additionalProperties": false, "required": ["const"], "properties": {"const": {"type": "number"}}},
        {"type": "object", "additionalProperties": false, "required": ["param"], "properties": {"param": {"type": "string"}}},
        {"type": "object", "additionalProperties": false, "required": ["op", "args"],
         "properties": {"op": {"enum": ["add", "sub", "mul"]}, "args": {"type": "array", "minItems": 2, "items": {"$ref": "#/$defs/operand"}}}}
      ]
    },
    "condition": {
      "type": "object", "additionalProperties": false, "required": ["op"],
      "properties": {
        "op": {"enum": ["gt", "ge", "lt", "le", "cross_above", "cross_below", "and", "or", "not",
                         "time_ge", "time_lt", "after_range_complete", "is_flat", "is_long", "is_short"]},
        "left": {"$ref": "#/$defs/operand"},
        "right": {"$ref": "#/$defs/operand"},
        "args": {"type": "array", "items": {"$ref": "#/$defs/condition"}},
        "time_local": {"type": "string", "pattern": "^\\d{2}:\\d{2}$"},
        "indicator": {"type": "string"}
      }
    },
    "rule": {
      "type": "object", "additionalProperties": false, "required": ["id", "action", "when"],
      "properties": {
        "id": {"type": "string"},
        "action": {"enum": ["ENTER_LONG", "ENTER_SHORT", "EXIT_LONG", "EXIT_SHORT", "EXIT_ALL"]},
        "when": {"$ref": "#/$defs/condition"},
        "description": {"type": "string"}
      }
    },
    "indicator": {
      "type": "object", "additionalProperties": false, "required": ["id", "type", "input", "params"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
        "type": {"enum": ["SMA", "EMA", "ATR_WILDER", "TRUE_RANGE", "OPENING_RANGE_HIGH", "OPENING_RANGE_LOW",
                          "ROLLING_MAX", "ROLLING_MIN", "PRICE"]},
        "input": {"enum": ["open", "high", "low", "close", "volume", "hlc"]},
        "params": {"type": "object", "additionalProperties": {"oneOf": [{"type": "number"}, {"type": "object", "required": ["param"], "properties": {"param": {"type": "string"}}, "additionalProperties": false}]}},
        "lag": {"type": "integer", "minimum": 0},
        "series_scope": {"enum": ["PER_CONTRACT", "PER_SESSION", "CONTINUOUS_ELIGIBLE_BARS"],
                          "description": "PER_SESSION resets at each session (e.g. opening range). Indicators never span an exclusion window or a contract change."}
      }
    },
    "exit_level": {
      "type": "object", "additionalProperties": false, "required": ["type"],
      "properties": {
        "type": {"enum": ["NONE", "FIXED_POINTS", "PERCENT", "ATR_MULTIPLE", "RANGE_OPPOSITE_SIDE"]},
        "value": {"oneOf": [{"type": "number", "exclusiveMinimum": 0}, {"type": "object", "required": ["param"], "properties": {"param": {"type": "string"}}, "additionalProperties": false}]},
        "atr_indicator": {"type": "string"},
        "reference": {"enum": ["ENTRY_FILL_PRICE", "SIGNAL_BAR_CLOSE"]},
        "evaluation": {"const": "BAR_CLOSE", "description": "v1 evaluates stops on bar close and exits next bar open; intrabar stop simulation is deliberately excluded (same-bar ordering is unknown)."}
      }
    }
  }
}
