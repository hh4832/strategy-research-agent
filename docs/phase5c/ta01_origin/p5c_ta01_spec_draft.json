{
  "spec_version": "1.0.0",
  "strategy_id": "p5c_ta01_res20_strongclose_relvol_tsm_15m",
  "name": "P5C-TA-01 PROPOSAL ONLY: 20-bar resistance breakout + strong-close candle + relative volume (TSM 15m)",
  "version": "0.0.1",
  "status": "DRAFT",
  "hypothesis": {
    "statement": "A completed 15m RTH bucket that closes above the highest high of the prior 20 eligible buckets, closes in the top quarter of its own range, and trades at least twice the prior 20-bucket average volume marks accepted resistance breaks that continue over the next hours.",
    "mechanism": "Resistance at a recent high concentrates resting sell orders; a strong close on unusually high volume indicates that this supply was absorbed by aggressive buyers rather than a thin, quickly reversed probe.",
    "falsifiable_prediction": "Mean net PnL per closed trade at BASE cost exceeds the pre-registered random-entry null with identical exits and costs.",
    "null_hypothesis": "Mean net PnL per closed trade at BASE cost does not exceed the random-entry null.",
    "rationale_category": "TREND_FOLLOWING",
    "expected_holding_period": "up to 8 eligible 15m buckets; flat by the 15:15 ET decision",
    "known_failure_modes": [
      "breakout failure / stop runs",
      "volume spikes from auctions or news mis-attributed",
      "edge below costs"
    ],
    "references": [
      "PROPOSAL ONLY; Phase 5-C; no backtest"
    ]
  },
  "universe": {
    "market": "IBKR",
    "symbols": [
      "TSM"
    ],
    "timeframe": "15m",
    "source_timeframe": "1m",
    "aggregation": {
      "label": "start",
      "closed": "left",
      "require_complete": true,
      "session_anchored": true
    },
    "timezone": "America/New_York",
    "contract_policy": {
      "type": "NOT_APPLICABLE",
      "continuous_inferred": false,
      "indicator_series": "NOT_APPLICABLE"
    },
    "sessions": {
      "allowed": [
        "RTH"
      ],
      "calendar_ref": "NYSE RTH 09:30-16:00 America/New_York (DST-aware; source timestamps are UTC)",
      "exclude_closing_auction": true,
      "no_overnight": true
    }
  },
  "data_requirements": {
    "datasets": [
      {
        "dataset_id": "ibkr_tsm_1m_normalized",
        "snapshot_id": "20261101_205431_06359faf7ef4_IBKR_FINAL_GATE_FULL",
        "producer_commit_sha": "06359faf7ef4b8ff702a7ab1a6d07521d3b68f28",
        "verdict": "GO",
        "usage_scope": "BACKTEST",
        "access_contract": "Data Access Contract v0.1 (MarketDataClient.load('TSM'))"
      }
    ],
    "warmup_bars": 90,
    "fields": [
      "open",
      "high",
      "low",
      "close",
      "volume"
    ]
  },
  "parameters": {
    "values": {
      "res_n": {
        "type": "integer",
        "default": 20,
        "min": 20,
        "max": 20,
        "step": 1,
        "description": "resistance lookback (eligible 15m buckets, excluding current)"
      },
      "vol_m": {
        "type": "integer",
        "default": 20,
        "min": 20,
        "max": 20,
        "step": 1,
        "description": "relative-volume baseline length (eligible buckets, excluding current)"
      },
      "vol_k": {
        "type": "number",
        "default": 2.0,
        "min": 2.0,
        "max": 2.0,
        "step": 0.5,
        "description": "relative-volume multiple"
      },
      "close_pos": {
        "type": "number",
        "default": 0.75,
        "min": 0.75,
        "max": 0.75,
        "step": 0.05,
        "description": "strong close: close in top (1-close_pos) of the bar range"
      },
      "sup_l": {
        "type": "integer",
        "default": 10,
        "min": 10,
        "max": 10,
        "step": 1,
        "description": "trailing support lookback for the exit"
      }
    },
    "constraints": [],
    "search": {
      "mode": "FIXED",
      "max_trials": 1
    }
  },
  "signal": {
    "evaluation_time": "BAR_CLOSE",
    "indicators": [
      {
        "id": "res",
        "type": "ROLLING_MAX",
        "input": "high",
        "params": {
          "period": {
            "param": "res_n"
          }
        },
        "lag": 1,
        "series_scope": "CONTINUOUS_ELIGIBLE_BARS"
      },
      {
        "id": "vol_avg",
        "type": "SMA",
        "input": "volume",
        "params": {
          "period": {
            "param": "vol_m"
          }
        },
        "lag": 1,
        "series_scope": "CONTINUOUS_ELIGIBLE_BARS"
      },
      {
        "id": "sup",
        "type": "ROLLING_MIN",
        "input": "low",
        "params": {
          "period": {
            "param": "sup_l"
          }
        },
        "lag": 1,
        "series_scope": "CONTINUOUS_ELIGIBLE_BARS"
      }
    ],
    "entry_rules": [
      {
        "id": "res_break_strong_close_relvol",
        "action": "ENTER_LONG",
        "description": "all three must hold on the same completed eligible bucket",
        "when": {
          "op": "and",
          "args": [
            {
              "op": "is_flat"
            },
            {
              "op": "time_lt",
              "time_local": "14:30"
            },
            {
              "op": "gt",
              "left": {
                "ref": "close"
              },
              "right": {
                "ref": "res"
              }
            },
            {
              "op": "gt",
              "left": {
                "ref": "close"
              },
              "right": {
                "ref": "open"
              }
            },
            {
              "op": "gt",
              "left": {
                "ref": "high"
              },
              "right": {
                "ref": "low"
              }
            },
            {
              "op": "ge",
              "left": {
                "op": "sub",
                "args": [
                  {
                    "ref": "close"
                  },
                  {
                    "ref": "low"
                  }
                ]
              },
              "right": {
                "op": "mul",
                "args": [
                  {
                    "param": "close_pos"
                  },
                  {
                    "op": "sub",
                    "args": [
                      {
                        "ref": "high"
                      },
                      {
                        "ref": "low"
                      }
                    ]
                  }
                ]
              }
            },
            {
              "op": "ge",
              "left": {
                "ref": "volume"
              },
              "right": {
                "op": "mul",
                "args": [
                  {
                    "param": "vol_k"
                  },
                  {
                    "ref": "vol_avg"
                  }
                ]
              }
            }
          ]
        }
      }
    ],
    "exit_rules": [
      {
        "id": "support_break",
        "action": "EXIT_LONG",
        "when": {
          "op": "lt",
          "left": {
            "ref": "close"
          },
          "right": {
            "ref": "sup"
          }
        }
      }
    ],
    "max_entries_per_session": 1
  },
  "position_sizing": {
    "method": "FIXED_UNITS",
    "units": 100,
    "max_units": 100,
    "initial_capital": 100000
  },
  "risk_exits": {
