  "additionalProperties": false,
  "description": "No OHLCV. Required evidence may explicitly be MISSING/UNTRUSTED, causing BLOCKED, RETEST, UNDETERMINED. See docs/RESEARCH_EVALUATOR_CONTRACT.md for metric formulas, units and authority. A complete JSON shape is not proof of evidence sufficiency.",
  "$defs": {
    "metric_definitions": {
      "total_return": {
        "description": "Core equity final / declared initial capital - 1; net mark-to-market, includes open positions; not gross return."
      },
      "net_return": {
        "description": "Sum VALID closed Core trade net_pnl / initial capital; excludes open and invalidated trades."
      },
      "annualized_return": {
        "description": "Geometric ACT/365.2425 CAGR only when actual equity observations span >=365.2425 days, first equity equals initial capital, and upstream declares zero external_cash_flows. Uses actual first/last timestamps, never declared sample length or a universal bars/year factor."
      },
      "trade_statistics": {
        "description": "Existing evaluation.research.trade_stats: n>=10 for ratios. Wins net_pnl>0, losses<0, zeros count in n. Average loss negative, expectancy sum/n. PF=sum wins/abs(sum losses), undefined with no losses."
      },
      "max_drawdown": {
        "description": "Existing evaluation.metrics.max_drawdown on Core archived equity (negative fraction); does not alter the authoritative curve by adding observations. Duration is elapsed seconds below a previous observed high watermark, unrecovered through final observation."
      },
      "volatility": {
        "description": "Unannualized sample std (ddof=1) adjacent Core equity simple returns. Only >=2 returns and explicitly REGULAR, actually equal timestamp spacing. No daily assumption."
      },
      "tail_loss": {
        "description": "Existing research.MIN_RETURNS_FOR_TAIL=100; empirical 5% quantile and mean returns <=quantile, observation interval recorded; no annualization."
      },
      "exposure": {
        "description": "Upstream Core/diagnostic held-bar fraction [0,1], never inferred from wall-clock overnight holding spans."
      },
      "turnover": {
        "description": "Sum explicit upstream fill.notional /2 / arithmetic mean Core equity. Nonannualized; no price*qty fallback for derivatives, FX or multipliers."
      },
      "cost_to_gross_profit": {
        "description": "Explicit debited costs / sum positive VALID closed gross_pnl; NOT net gross PnL. Embedded slippage never deducted again."
      },
      "rejection_rate": {
        "description": "Rejected orders / declared orders_submitted; only available for one rejection record per rejected order and count<=submitted. Fill count is not order count."
      },
      "holding_period": {
        "description": "Elapsed wall-clock seconds exit-entry; no assumed bar/calendar count. Closed VALID trades only."
      }
    }
  }
}
