{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/hh4832/strategy-research-agent/schemas/COST_SCENARIO_SET_SCHEMA.json",
  "title": "Cost scenario set (M3-B.2)",
  "description": "Pre-registered cost sensitivity for ONE strategy configuration. Core computes every cost; this file only pins which CostProfile and which Core cost_multiplier each scenario uses. Scenarios are sensitivity analysis of the same strategy, never separate families or parameter trials.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "scenario_set_id", "version", "scenarios"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "scenario_set_id": {"type": "string", "pattern": "^[a-z0-9_]+$"},
    "version": {"type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$"},
    "description": {"type": "string"},
    "scenarios": {
      "type": "array", "minItems": 1, "maxItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["scenario_id", "kind", "profile_ref", "cost_multiplier", "commission_model"],
        "properties": {
          "scenario_id": {"type": "string", "pattern": "^[A-Z0-9_]+$"},
          "kind": {"enum": ["BASE", "LOW", "STRESS", "CUSTOM"]},
          "profile_ref": {
            "type": "object", "additionalProperties": false, "required": ["profile_id", "version", "sha256"],
            "properties": {"profile_id": {"type": "string"}, "version": {"type": "string"},
                           "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
          },
          "cost_multiplier": {"type": "number", "minimum": 0},
          "commission_model": {"enum": ["ALL_IN", "UNBUNDLED"],
                               "description": "ALL_IN: the COMMISSION component already includes exchange/regulatory fees, so no separate fee component may exist (no double counting)."},
          "description": {"type": "string"}
        }
      }
    }
  }
}
