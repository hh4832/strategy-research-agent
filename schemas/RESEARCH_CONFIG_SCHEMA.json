{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:strategy-agent:research-config:1.0.0",
  "title": "Research configuration v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "config_id": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "market": {
      "type": "string",
      "minLength": 1
    },
    "instrument": {
      "type": "string",
      "minLength": 1
    },
    "timeframe": {
      "type": "string",
      "minLength": 1
    },
    "spec_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "dataset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dataset_id",
        "snapshot_id",
        "producer_commit_sha"
      ],
      "properties": {
        "dataset_id": {
          "type": "string",
          "minLength": 1
        },
        "snapshot_id": {
          "type": "string",
          "minLength": 1
        },
        "producer_commit_sha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        }
      }
    },
    "strategy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "parameters"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "parameters": {
          "type": "object",
          "additionalProperties": {
            "type": "number"
          }
        }
      }
    },
    "temporal_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version",
        "sha256",
        "evidence_ref",
        "status"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "evidence_ref": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "SYNTHETIC_ONLY",
            "PENDING",
            "APPROVED"
          ]
        }
      }
    },
    "cost_scenarios": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "profile_id",
          "version",
          "sha256",
          "multiplier",
          "currency",
          "commission_model",
          "slippage_model",
          "fee_basis",
          "assumption_status",
          "approval_status",
          "core_compatibility"
        ],
        "properties": {
          "id": {
            "enum": [
              "BASE",
              "LOW",
              "STRESS",
              "CUSTOM"
            ]
          },
          "profile_id": {
            "type": "string",
            "minLength": 1
          },
          "version": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "multiplier": {
            "type": "number",
            "minimum": 0
          },
          "currency": {
            "type": "string",
            "minLength": 1
          },
          "commission_model": {
            "type": "string",
            "minLength": 1
          },
          "slippage_model": {
            "type": "string",
            "minLength": 1
          },
          "fee_basis": {
            "enum": [
              "COMPONENTS",
              "ALL_IN"
            ]
          },
          "assumption_status": {
            "enum": [
              "ASSUMED",
              "EVIDENCED"
            ]
          },
          "approval_status": {
            "enum": [
              "DRAFT",
              "APPROVED"
            ]
          },
          "core_compatibility": {
            "enum": [
              "PASS",
              "PENDING",
              "NO_GO"
            ]
          }
        }
      }
    },
    "windows": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "in_sample",
        "validation"
      ],
      "properties": {
        "in_sample": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "start",
            "end"
          ],
          "properties": {
            "start": {
              "type": "string",
              "format": "date-time"
            },
            "end": {
              "type": "string",
              "format": "date-time"
            }
          }
        },
        "validation": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "start",
            "end"
          ],
          "properties": {
            "start": {
              "type": "string",
              "format": "date-time"
            },
            "end": {
              "type": "string",
              "format": "date-time"
            }
          }
        }
      }
    },
    "holdout_id": {
      "type": "string",
      "minLength": 1
    },
    "initial_capital": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "position_sizing": {
      "type": "object"
    },
    "risk_limits": {
      "type": "object"
    },
    "output_location": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "schema_version",
    "config_id",
    "version",
    "sha256",
    "market",
    "instrument",
    "timeframe",
    "spec_sha256",
    "dataset",
    "strategy",
    "temporal_policy",
    "cost_scenarios",
    "windows",
    "holdout_id",
    "initial_capital",
    "position_sizing",
    "risk_limits",
    "output_location"
  ]
}
