    "bias_risk_checklist": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "risk": {
            "enum": [
              "LOOK_AHEAD_BIAS",
              "SURVIVORSHIP_BIAS",
              "SELECTION_BIAS",
              "DATA_SNOOPING",
              "TRANSACTION_COSTS",
              "SLIPPAGE",
              "LIQUIDITY",
              "SAMPLE_SIZE",
              "CONCENTRATED_PROFIT",
              "HOLDOUT_CONTAMINATION"
            ]
          },
          "status": {
            "const": "NOT_VERIFIED"
          },
          "required_check": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "risk",
          "status",
          "required_check"
        ]
      }
    },
    "fingerprints": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
