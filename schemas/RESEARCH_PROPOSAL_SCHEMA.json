        "adapter_id",
        "draft_sha256",
        "agent_commit_sha",
        "created_at",
        "input_kind"
      ]
    },
    "draft": {
      "$ref": "#/$defs/draft"
    },
    "evaluation_plan": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "protocol": {
          "const": "QUANT_EVALUATION_PROTOCOL v1.0"
        },
        "metrics": {
          "const": [
            "Trade Count",
            "Win Rate",
            "Payoff Ratio",
            "Expectancy",
            "Profit Factor",
            "Maximum Drawdown",
            "Tail Risk",
            "Cost Sensitivity",
            "Market Regime",
            "Annual Performance",
            "Symbol Concentration",
            "Holding Duration",
            "Parameter Robustness"
          ]
        },
        "threshold_policy": {
          "const": "USE_EXISTING_PROTOCOL_ONLY; NO_NEW_THRESHOLDS"
        }
      },
      "required": [
