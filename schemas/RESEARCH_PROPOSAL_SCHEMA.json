          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "strategy_family": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "parameter_values": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "method": {
