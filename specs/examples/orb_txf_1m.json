    },
    "tax": {
      "rate_side": 2e-05,
      "sell_rate": 0,
      "rounding": "ROUND_HALF_UP_INTEGER"
    },
    "slippage": {
      "model": "TICKS",
      "value": 1,
      "tick_size_ref": "TXF tick = 1 index point"
    },
    "sensitivity_multipliers": [
      0,
      1,
      2,
      3
    ]
  },
  "risk_constraints": {
    "allowed_directions": [
      "LONG",
      "SHORT"
    ],
    "max_position_units": 1,
    "max_trades_per_session": 2,
    "max_daily_loss": 60000
  },
  "experiment": {
