    "evaluation_protocol": "QUANT_EVALUATION_PROTOCOL v1.0",
    "split_ref": "SPLIT-TXF-BOUNDED-v1 (session-blocked; to be registered after Phase-2 GO)",
    "holdout_lock_id": "HOLDOUT-TXF-BOUNDED-v1",
    "trial_family_id": "FAM-ORB-TXF",
    "compute_budget": {
