          }
        },
        "series_scope": "CONTINUOUS_ELIGIBLE_BARS"
      }
    ],
    "entry_rules": [
      {
        "id": "golden_cross",
        "action": "ENTER_LONG",
        "when": {
          "op": "and",
          "args": [
