{
  "spec_version": "1.0.0",
  "strategy_id": "sma_crossover_tsm_15m_5_20",
  "name": "SMA crossover 5/20 — TSM ADR, 15-minute RTH bars, long only (M3-B fixed baseline)",
  "version": "0.1.0",
  "status": "DRAFT",
  "hypothesis": {
    "statement": "Short-horizon price trends in TSM persist long enough that a 5-bar SMA crossing above a 20-bar SMA on 15-minute RTH bars precedes positive returns net of costs.",
    "mechanism": "Information is incorporated gradually (order splitting by large holders, ADR catching up with Taiwan-hours news), producing short-horizon serial correlation that a fast/slow moving-average crossing can detect. This is an untested hypothesis, not evidence that SMA is profitable.",
    "falsifiable_prediction": "Mean net PnL per round trip > 0 at the 1x cost multiplier, profit factor > 1, and the result survives the 2x cost multiplier, over a sample of at least 30 valid round trips.",
    "null_hypothesis": "Net returns of crossover trades are indistinguishable from zero or from random-entry trades with the same holding-time distribution.",
    "rationale_category": "TREND_FOLLOWING",
    "expected_holding_period": "several 15-minute bars to a few sessions",
    "known_failure_modes": [
      "range-bound regimes with frequent whipsaws",
      "cost drag from frequent crossings",
      "overnight gaps (positions may be held overnight)",
      "ADR reaction to Taiwan-hours information outside RTH"
    ],
    "references": [
      "M3-B task: SMA 5/20 is the fixed engineering baseline; no parameter search"
    ]
  },
